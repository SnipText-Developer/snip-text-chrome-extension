{
  "name": "@snip-text",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:insert-text": "node --test tests/insert-text.test.mjs",
    "dev": "npm --workspace @snip-text/sidebar run dev",
    "build": "npm run build:popup && tsc && webpack --config webpack.config.cjs && npm run build:sidebar",
    "build:popup": "npm --workspace @snip-text/mini-popup run build",
    "build:sidebar": "npm --workspace @snip-text/sidebar run build && node --input-type=module -e \"import {rmSync,cpSync} from 'node:fs'; rmSync('dist/src/page',{recursive:true,force:true}); cpSync('packages/sidebar/dist','dist/src/page',{recursive:true});\""
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@snip-text/mini-popup": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.3",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.3",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
