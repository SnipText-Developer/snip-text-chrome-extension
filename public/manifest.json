{
  "manifest_version": 3,
  "name": "Snip Text",
  "version": "1.0",
  "permissions": [
    "sidePanel",
    "activeTab",
    "background",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": ["http://localhost/*", "https://api.sniptext.kr/*"],
  "externally_connectable": {
    "matches": ["https://sniptext.kr/*", "http://localhost:3000/*"]
  },
  "background": {
    "service_worker": "./src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["./src/content/gmail.js"],
      "type": "module",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.naver.com/*"],
      "js": ["./src/content/naver.js"],
      "type": "module",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "./src/page/index.html"
  },
  "action": {
    "default_icon": {}
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; style-src 'self' https://cdnjs.cloudflare.com/ajax/libs/pretendard/1.3.9/static/pretendard.min.css; font-src 'self' https://cdnjs.cloudflare.com; connect-src 'self' https://api.sniptext.kr"
  }
}
